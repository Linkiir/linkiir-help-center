{"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"properties":{"moved":{"items":{"properties":{"topic":{"type":"string","title":"Topic","description":"Topic that moved."},"partition":{"type":"integer","title":"Partition","description":"Partition that moved."},"previous":{"type":"integer","title":"Previous","description":"Where the node was resuming from before the move."},"offset":{"type":"integer","title":"Offset","description":"Where it resumes from now."}},"type":"object","required":["topic","partition","previous","offset"],"title":"RepositionResult"},"type":"array","title":"Moved","description":"Partitions whose position changed. A partition already at the requested offset is omitted."},"skipped":{"type":"integer","title":"Skipped","description":"Messages the node will now never process."},"replayed":{"type":"integer","title":"Replayed","description":"Already-processed messages the node will process again."},"queue":{"type":"integer","title":"Queue","description":"Queue depth after the move."}},"type":"object","required":["moved","skipped","replayed","queue"],"title":"RepositionQueueResponse"}}}},"400":{"description":"Bad request: node has no queue, or an offset is out of range"},"404":{"description":"Node not found"},"409":{"description":"Stop the node before repositioning its queue"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"properties":{"detail":{"items":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"}}}},"503":{"description":"Kafka broker unavailable"}}}